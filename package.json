{
  "name": "silvermoon-relay",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @silvermoon-relay/web --filter @silvermoon-relay/worker dev",
    "lint": "oxlint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "silvermoon": "^0.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "overrides": {
      "silvermoon": "https://codeload.github.com/shazhou-ww/silvermoon/tar.gz/cfabf52936b7372d45f43e07ab813a2271fe4938"
    }
  }
}
