{
  "name": "@silvermoon-relay/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "d1:migrate:local": "wrangler d1 migrations apply silvermoon-relay --local",
    "test": "vitest run",
    "typecheck": "wrangler types --check && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@silvermoon-relay/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.147.0"
  }
}
