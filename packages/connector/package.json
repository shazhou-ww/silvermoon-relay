{
  "name": "@silvermoon-ai/connector",
  "version": "0.1.0",
  "description": "Local agent connector for Silvermoon Relay",
  "repository": {
    "type": "git",
    "url": "https://github.com/shazhou-ww/silvermoon-ai.git",
    "directory": "packages/connector"
  },
  "homepage": "https://github.com/shazhou-ww/silvermoon-ai/tree/main/packages/connector#readme",
  "bugs": {
    "url": "https://github.com/shazhou-ww/silvermoon-ai/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "silvermoon-connector": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.19",
    "@microsoft/agent-host-protocol": "^1.0.0",
    "@trpc/client": "^11.19.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@silvermoon-ai/protocol": "workspace:*",
    "@silvermoon-ai/rpc": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
